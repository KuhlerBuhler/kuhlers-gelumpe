{
  "name": "kuhlers-gelumpe",
  "version": "1.0.0",
  "private": true,
  "description": "A browser editor for the Korg Electribe 2 Sampler with Hacktribe, with a linter and a simulated device that check every change before it reaches the hardware",
  "type": "module",
  "bin": {
    "e2": "./bin/e2.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./node": "./src/node.mjs",
    "./webmidi": "./src/webmidi.mjs"
  },
  "files": [
    "src",
    "bin",
    "data",
    "site",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node tools/start.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:ci": "node --test --test-timeout=300000 \"test/*.test.mjs\"",
    "serve": "node tools/serve.mjs",
    "build:site": "node tools/build-site.mjs",
    "verify:patches": "node tools/verify-patches.mjs",
    "build:codemirror": "node tools/build-codemirror.mjs",
    "build:blech-patch": "node tools/build-blech-patch.mjs",
    "test:local": "E2_LOCAL_REQUIRED=1 node --test \"test/*.test.mjs\"",
    "test:e2e": "node --test --test-timeout=180000 \"test/e2e/*.e2e.mjs\"",
    "test:all": "node tools/test-all.mjs",
    "test:emu": "E2_EMU_REQUIRED=1 node --test test/emulator.test.mjs test/emulator-session.test.mjs test/emulator-card.test.mjs test/emulator-card-stock.test.mjs test/emulator-stock.test.mjs test/emulator-update.test.mjs test/emulator-blue.test.mjs test/emulator-modtable.test.mjs test/emulator-sample-full.test.mjs test/emulator-sample-meta.test.mjs test/emulator-blechy.test.mjs test/emu-service.test.mjs",
    "emu": "node tools/emu/start.mjs",
    "setup:emu": "node tools/emu/setup.mjs",
    "build:sidecar": "node tools/emu/build-sidecar.mjs",
    "release": "node tools/release.mjs",
    "app:dev": "cargo tauri dev",
    "app:build": "cargo tauri build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}

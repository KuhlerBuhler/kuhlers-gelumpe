{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuhlers GELUMPE",
  "version": "1.3.2",
  "identifier": "de.kbproductions.gelumpe",
  "build": {
    "beforeDevCommand": "node tools/build-site.mjs",
    "beforeBuildCommand": "node tools/build-site.mjs && node tools/emu/build-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "externalBin": ["binaries/Gelumpe Emulator"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" }
    },
    "linux": {
      "deb": {
        "depends": ["libasound2"]
      }
    }
  }
}

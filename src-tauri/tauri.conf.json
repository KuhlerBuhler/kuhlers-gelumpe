{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuhlers GELUMPE",
  "version": "1.4.0",
  "identifier": "de.kbproductions.gelumpe",
  "build": {
    "beforeDevCommand": "node tools/build-site.mjs",
    "beforeBuildCommand": "node tools/build-site.mjs && node tools/emu/build-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "externalBin": ["binaries/Gelumpe Emulator"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" }
    },
    "linux": {
      "deb": {
        "depends": ["libasound2"]
      }
    },
    "macOS": {
      "dmg": {
        "background": "../assets/dmg/background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 215 },
        "applicationFolderPosition": { "x": 480, "y": 215 }
      }
    }
  }
}

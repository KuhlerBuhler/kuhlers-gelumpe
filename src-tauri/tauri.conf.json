{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuhlers GELUMPE",
  "version": "1.1.0",
  "identifier": "de.kbproductions.gelumpe",
  "build": {
    "beforeDevCommand": "node tools/build-site.mjs",
    "beforeBuildCommand": "node tools/build-site.mjs && node tools/emu/build-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "externalBin": ["binaries/gelumpe-emu"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

+/* Worker build: the GNU probe decides legality and DISALGNEXCPT of dsp32
+   ALU and shift insns; an encoding GNU rejects goes to GNU whole.  A legal
+   one runs GNU's decoder ported onto the QEMU state (HELPER(dsp32_port),
+   bfin-gnu-dsp32.c.inc), or with bfin_blech_dsp32_route in the GNU library
+   itself (HELPER(dsp32_gnu)). */
+static bool
+blech_dsp32_gnu(DisasContext *dc, uint16_t iw0, uint16_t iw1)
+{
+    uint32_t insn = ((uint32_t)iw0 << 16) | iw1;
+
+    if (!bfin_blech_dsp32) {
+        return false;
+    }
+    switch (bfin_blech_dsp32(1, insn, NULL)) {
+    case 0:
+        illegal_instruction(dc);
+        return true;
+    case 3:
+        dc->disalgnexcpt = true;
+        break;
+    }
+    gen_astat_update(dc, true);
+    /* Hot ALU form: Rd = Rs +/- Rt with x=0, HL=0 (aopcde 4, aop 0/1). */
+    if ((iw0 & 0xF7FF) == 0xC404 && (iw1 & 0x9000) == 0) {
+        gen_dsp32_addsub32((iw1 >> 9) & 7, (iw1 >> 3) & 7, iw1 & 7,
+                           iw1 & 0x4000, iw1 & 0x2000);
+        return true;
+    }
+    if ((iw0 & 0xF7FF) == 0xC40B && (iw1 & 0xF000) == 0) {
+        gen_helper_dsp32_a0adda1(tcg_env, tcg_constant_i32((iw1 >> 9) & 7));
+        return true;
+    }
+    if ((iw0 & 0xF7FF) == 0xC683 && (iw1 & 0xE100) == 0x0100) {
+        gen_helper_dsp32_accashift(tcg_env, tcg_constant_i32(insn));
+        return true;
+    }
+    if (bfin_blech_dsp32_route) {
+        gen_helper_dsp32_gnu(tcg_env, tcg_constant_i32(insn));
+    } else {
+        gen_helper_dsp32_port(tcg_env, tcg_constant_i32(insn));
+    }
+    return true;
+}

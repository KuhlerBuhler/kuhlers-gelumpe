+/* Worker build: whether the GNU simulator accepts a dsp32 encoding; one it
+   rejects goes to GNU whole, which raises the exception. */
+static bool
+blech_dsp32_legal(DisasContext *dc, uint16_t iw0, uint16_t iw1)
+{
+    if (bfin_blech_dsp32 &&
+        !bfin_blech_dsp32(1, ((uint32_t)iw0 << 16) | iw1, NULL)) {
+        illegal_instruction(dc);
+        return false;
+    }
+    return true;
+}
+
+/* Rd = Rs +/- Rt (S) as GNU add32/sub32 (carry=1, parallel=0). */
+static void gen_dsp32_addsub32(int dst, int src0, int src1, bool sub, bool sat)
+{
+    TCGv a = cpu_dreg[src0], b = cpu_dreg[src1];
+    TCGv v = tcg_temp_new(), ov = tcg_temp_new(), t = tcg_temp_new();
+    TCGv c = tcg_temp_new();
+
+    if (sub) {
+        tcg_gen_sub_tl(v, a, b);
+        tcg_gen_xor_tl(ov, a, b);
+        tcg_gen_xor_tl(t, a, v);
+        tcg_gen_setcond_tl(TCG_COND_LEU, c, b, a);
+    } else {
+        tcg_gen_add_tl(v, a, b);
+        tcg_gen_xor_tl(ov, a, v);
+        tcg_gen_xor_tl(t, b, v);
+        tcg_gen_not_tl(c, a);
+        tcg_gen_setcond_tl(TCG_COND_LTU, c, c, b);
+    }
+    tcg_gen_and_tl(ov, ov, t);
+    tcg_gen_shri_tl(ov, ov, 31);
+    if (sat) {
+        tcg_gen_sari_tl(t, v, 31);
+        tcg_gen_xori_tl(t, t, 0x80000000);
+        tcg_gen_movcond_tl(TCG_COND_NE, v, ov, tcg_constant_tl(0), t, v);
+    }
+    tcg_gen_st_i32(c, tcg_env, offsetof(CPUArchState, astat[ASTAT_AC0]));
+    tcg_gen_st_i32(c, tcg_env, offsetof(CPUArchState, astat[ASTAT_AC0_COPY]));
+    tcg_gen_st_i32(ov, tcg_env, offsetof(CPUArchState, astat[ASTAT_V]));
+    tcg_gen_st_i32(ov, tcg_env, offsetof(CPUArchState, astat[ASTAT_V_COPY]));
+    tcg_gen_ld_i32(t, tcg_env, offsetof(CPUArchState, astat[ASTAT_VS]));
+    tcg_gen_or_tl(t, t, ov);
+    tcg_gen_st_i32(t, tcg_env, offsetof(CPUArchState, astat[ASTAT_VS]));
+    tcg_gen_shri_tl(t, v, 31);
+    tcg_gen_st_i32(t, tcg_env, offsetof(CPUArchState, astat[ASTAT_AN]));
+    tcg_gen_setcondi_tl(TCG_COND_EQ, t, v, 0);
+    tcg_gen_st_i32(t, tcg_env, offsetof(CPUArchState, astat[ASTAT_AZ]));
+    tcg_gen_mov_tl(cpu_dreg[dst], v);
+}

+static uint32_t mac_sat_s32(uint64_t val, uint32_t *ov)
+{
+    if ((int64_t)val < -0x80000000ll) {
+        *ov = 1;
+        return 0x80000000;
+    }
+    if ((int64_t)val > 0x7fffffff) {
+        *ov = 1;
+        return 0x7fffffff;
+    }
+    return val;
+}
+
+static uint32_t mac_sat_u32(uint64_t val, uint32_t *ov)
+{
+    if (val > 0xffffffff) {
+        *ov = 1;
+        return 0xffffffff;
+    }
+    return val;
+}
+
+static uint32_t mac_sat_s16(uint64_t val, uint32_t *ov)
+{
+    if ((int64_t)val < -0x8000ll) {
+        *ov = 1;
+        return 0x8000;
+    }
+    if ((int64_t)val > 0x7fff) {
+        *ov = 1;
+        return 0x7fff;
+    }
+    return val & 0xffff;
+}
+
+static uint32_t mac_sat_u16(uint64_t val, uint32_t *ov)
+{
+    if (val > 0xffff) {
+        *ov = 1;
+        return 0xffff;
+    }
+    return val;
+}
+
+static uint64_t mac_rnd16(uint64_t val)
+{
+    uint64_t sgnbits;
+
+    if ((val & 0xffff) > 0x8000
+        || ((val & 0xffff) == 0x8000 && (val & 0x10000))) {
+        val += 0x8000;
+    }
+    sgnbits = val & 0xffff000000000000ull;
+    val >>= 16;
+    return val | sgnbits;
+}
+
+static uint64_t mac_trunc16(uint64_t val)
+{
+    uint64_t sgnbits = val & 0xffff000000000000ull;
+    val >>= 16;
+    return val | sgnbits;
+}
+
+static uint32_t mac_extract(uint64_t res, int mmod, int MM, int fullword,
+                            uint32_t *ov)
+{
+    if (fullword) {
+        switch (mmod) {
+        case 0: case M_IS:
+            return mac_sat_s32(res, ov);
+        case M_IU: case M_FU:
+            return MM ? mac_sat_s32(res, ov) : mac_sat_u32(res, ov);
+        case M_S2RND: case M_ISS2:
+            return mac_sat_s32(res << 1, ov);
+        default:
+            return 0;
+        }
+    }
+    switch (mmod) {
+    case 0: case M_W32: case M_IH:
+        return mac_sat_s16(mac_rnd16(res), ov);
+    case M_IS:
+        return mac_sat_s16(res, ov);
+    case M_FU:
+        return MM ? mac_sat_s16(mac_rnd16(res), ov)
+                  : mac_sat_u16(mac_rnd16(res), ov);
+    case M_IU:
+        return MM ? mac_sat_s16(res, ov) : mac_sat_u16(res, ov);
+    case M_T:
+        return mac_sat_s16(mac_trunc16(res), ov);
+    case M_TFU:
+        return MM ? mac_sat_s16(mac_trunc16(res), ov)
+                  : mac_sat_u16(mac_trunc16(res), ov);
+    case M_S2RND:
+        return mac_sat_s16(mac_rnd16(res << 1), ov);
+    case M_ISS2:
+        return mac_sat_s16(res << 1, ov);
+    default:
+        return 0;
+    }
+}
+
+static uint32_t mac_func(CPUArchState *env, int which, int op, int h0, int h1,
+                         int src0, int src1, int mmod, int MM, int fullword,
+                         uint32_t *overflow, uint32_t *neg, uint64_t *newacc,
+                         uint32_t *avflag)
+{
+    uint64_t acc, ax = (env->areg[which] >> 32) & 0xff;
+    uint32_t aw = env->areg[which] & 0xffffffff;
+    uint32_t sat = 0, tsat, ret;
+
+    if (is_macmod_signed(mmod) || MM) {
+        if (ax & 0x80) {
+            ax |= -0x80;
+        }
+    }
+    acc = (ax << 32) | aw;
+    *avflag = (uint32_t)-1;
+
+    if (op != 3) {
+        uint8_t sgn40 = (acc >> 39) & 1;
+        uint64_t nosat_acc;
+        uint64_t res = mac_multfunc(env, h0, h1, src0, src1, mmod, MM, &tsat);
+
+        switch (op) {
+        case 0:
+            acc = res;
+            break;
+        case 1:
+            acc = acc + res;
+            break;
+        case 2:
+            acc = acc - res;
+            break;
+        }
+
+        nosat_acc = acc;
+        switch (mmod) {
+        case 0: case M_T: case M_IS: case M_ISS2: case M_S2RND:
+            if ((int64_t)acc < -((int64_t)1 << 39)) {
+                acc = -((uint64_t)1 << 39), sat = 1;
+            } else if ((int64_t)acc > 0x7fffffffffll) {
+                acc = 0x7fffffffffull, sat = 1;
+            }
+            break;
+        case M_TFU:
+            if (MM) {
+                if ((int64_t)acc < -((int64_t)1 << 39)) {
+                    acc = -((uint64_t)1 << 39), sat = 1;
+                }
+                if ((int64_t)acc > 0x7FFFFFFFFFll) {
+                    acc = 0x7FFFFFFFFFull, sat = 1;
+                }
+            } else {
+                if ((int64_t)acc < 0) {
+                    acc = 0, sat = 1;
+                }
+                if ((int64_t)acc > 0xFFFFFFFFFFll) {
+                    acc = 0xFFFFFFFFFFull, sat = 1;
+                }
+            }
+            break;
+        case M_IU:
+            if (!MM && acc & 0x8000000000000000ull) {
+                acc = 0x0, sat = 1;
+            }
+            if (!MM && acc > 0xFFFFFFFFFFull) {
+                acc = 0xFFFFFFFFFFull, sat = 1;
+            }
+            if (MM && acc > 0xFFFFFFFFFFull) {
+                acc &= 0xFFFFFFFFFFull;
+            }
+            if (acc & 0x8000000000ull) {
+                acc |= 0xffffff0000000000ull;
+            }
+            break;
+        case M_FU:
+            if (MM) {
+                if ((int64_t)acc < -((int64_t)1 << 39)) {
+                    acc = -((uint64_t)1 << 39), sat = 1;
+                }
+                if ((int64_t)acc > 0x7FFFFFFFFFll) {
+                    acc = 0x7FFFFFFFFFull, sat = 1;
+                } else if (acc & 0x8000000000ull) {
+                    acc |= 0xffffff0000000000ull;
+                }
+            } else {
+                if ((int64_t)acc < 0) {
+                    acc = 0x0, sat = 1;
+                } else if ((int64_t)acc > (int64_t)0xFFFFFFFFFFll) {
+                    acc = 0xFFFFFFFFFFull, sat = 1;
+                }
+            }
+            break;
+        case M_IH:
+            if ((int64_t)acc < -0x80000000ll) {
+                acc = -0x80000000ull, sat = 1;
+            } else if ((int64_t)acc > 0x7fffffffll) {
+                acc = 0x7fffffffull, sat = 1;
+            }
+            break;
+        case M_W32:
+            if (sgn40 && ((acc >> 31) != 0x1ffffffff) && ((acc >> 31) != 0x0)) {
+                acc = 0x80000000, sat = 1;
+            }
+            if (!sat && !sgn40 && ((acc >> 31) != 0x0)
+                && ((acc >> 31) != 0x1ffffffff)) {
+                acc = 0x7FFFFFFF, sat = 1;
+            }
+            acc &= 0xffffffff;
+            if (acc & 0x80000000) {
+                acc |= 0xffffffff00000000ull;
+            }
+            if (tsat) {
+                sat = 1;
+            }
+            break;
+        default:
+            break;
+        }
+
+        if (acc & 0x8000000000ull) {
+            *neg = 1;
+        }
+        *newacc = acc & 0xffffffffffull;
+        *avflag = sat;
+
+        if (sat) {
+            if (fullword) {
+                *overflow = 1;
+            } else {
+                mac_extract(nosat_acc, mmod, MM, fullword, overflow);
+            }
+        }
+    }
+
+    ret = mac_extract(acc, mmod, MM, fullword, overflow);
+    if (!fullword) {
+        if (ret & 0x8000) {
+            *neg = 1;
+        }
+    } else if (ret & 0x80000000) {
+        *neg = 1;
+    }
+    return ret;
+}
+
+void HELPER(dsp32mac)(CPUArchState *env, uint32_t insn)
+{
+    uint32_t iw0 = insn >> 16, iw1 = insn & 0xffff;
+    int op1  = ((iw0 >> (DSP32Mac_op1_bits - 16)) & DSP32Mac_op1_mask);
+    int w1   = ((iw0 >> (DSP32Mac_w1_bits - 16)) & DSP32Mac_w1_mask);
+    int P    = ((iw0 >> (DSP32Mac_p_bits - 16)) & DSP32Mac_p_mask);
+    int MM   = ((iw0 >> (DSP32Mac_MM_bits - 16)) & DSP32Mac_MM_mask);
+    int mmod = ((iw0 >> (DSP32Mac_mmod_bits - 16)) & DSP32Mac_mmod_mask);
+    int w0   = ((iw1 >> DSP32Mac_w0_bits) & DSP32Mac_w0_mask);
+    int src0 = ((iw1 >> DSP32Mac_src0_bits) & DSP32Mac_src0_mask);
+    int src1 = ((iw1 >> DSP32Mac_src1_bits) & DSP32Mac_src1_mask);
+    int dst  = ((iw1 >> DSP32Mac_dst_bits) & DSP32Mac_dst_mask);
+    int h10  = ((iw1 >> DSP32Mac_h10_bits) & DSP32Mac_h10_mask);
+    int h00  = ((iw1 >> DSP32Mac_h00_bits) & DSP32Mac_h00_mask);
+    int op0  = ((iw1 >> DSP32Mac_op0_bits) & DSP32Mac_op0_mask);
+    int h11  = ((iw1 >> DSP32Mac_h11_bits) & DSP32Mac_h11_mask);
+    int h01  = ((iw1 >> DSP32Mac_h01_bits) & DSP32Mac_h01_mask);
+    uint32_t res = env->dreg[dst], res0 = 0, res1 = 0;
+    uint32_t v_0 = 0, v_1 = 0, zero = 0, n_1 = 0, n_0 = 0;
+    uint32_t av0 = (uint32_t)-1, av1 = (uint32_t)-1;
+    uint64_t acc0 = 0, acc1 = 0;
+    int do1 = (w1 == 1 || op1 != 3), do0 = (w0 == 1 || op0 != 3);
+
+    /* Both halves read the sources before any write-back.  */
+    if (do1) {
+        res1 = mac_func(env, 1, op1, h01, h11, src0, src1, mmod, MM, P,
+                        &v_1, &n_1, &acc1, &av1);
+        if (op1 == 3) {
+            zero = !!(res1 == 0);
+        }
+        if (!w1) {
+            v_1 = 0;
+        }
+    }
+    if (do0) {
+        res0 = mac_func(env, 0, op0, h00, h10, src0, src1, mmod, 0, P,
+                        &v_0, &n_0, &acc0, &av0);
+        if (op0 == 3) {
+            zero |= !!(res0 == 0);
+        }
+        if (!w0) {
+            v_0 = 0;
+        }
+    }
+
+    if (av1 != (uint32_t)-1) {
+        env->areg[1] = (int64_t)(acc1 << 24) >> 24;
+        env->astat[ASTAT_AV1] = av1;
+        if (av1) {
+            env->astat[ASTAT_AV1S] = 1;
+        }
+    }
+    if (av0 != (uint32_t)-1) {
+        env->areg[0] = (int64_t)(acc0 << 24) >> 24;
+        env->astat[ASTAT_AV0] = av0;
+        if (av0) {
+            env->astat[ASTAT_AV0S] = 1;
+        }
+    }
+
+    if (do1 && w1) {
+        if (P) {
+            env->dreg[dst + 1] = res1;
+        } else {
+            res = (res1 << 16) | (res & 0xffff);
+        }
+    }
+    if (do0 && w0) {
+        if (P) {
+            env->dreg[dst] = res0;
+        } else {
+            res = (res & 0xffff0000) | (res0 & 0xffff);
+        }
+    }
+
+    if (!P && (w0 || w1)) {
+        env->dreg[dst] = res;
+    }
+    if (P || w0 || w1) {
+        env->astat[ASTAT_V] = v_0 | v_1;
+        if (v_0 || v_1) {
+            env->astat[ASTAT_VS] = 1;
+        }
+    }
+    if ((w0 == 1 && op0 == 3) || (w1 == 1 && op1 == 3)) {
+        env->astat[ASTAT_AZ] = zero;
+        if (!(w0 == 1 && op0 == 3)) {
+            n_0 = 0;
+        }
+        if (!(w1 == 1 && op1 == 3)) {
+            n_1 = 0;
+        }
+        env->astat[ASTAT_AN] = n_1 | n_0;
+    }
+}
+
+void HELPER(dsp32mult)(CPUArchState *env, uint32_t insn)
+{
+    uint32_t iw0 = insn >> 16, iw1 = insn & 0xffff;
+    int w1   = ((iw0 >> (DSP32Mac_w1_bits - 16)) & DSP32Mac_w1_mask);
+    int P    = ((iw0 >> (DSP32Mac_p_bits - 16)) & DSP32Mac_p_mask);
+    int MM   = ((iw0 >> (DSP32Mac_MM_bits - 16)) & DSP32Mac_MM_mask);
+    int mmod = ((iw0 >> (DSP32Mac_mmod_bits - 16)) & DSP32Mac_mmod_mask);
+    int w0   = ((iw1 >> DSP32Mac_w0_bits) & DSP32Mac_w0_mask);
+    int src0 = ((iw1 >> DSP32Mac_src0_bits) & DSP32Mac_src0_mask);
+    int src1 = ((iw1 >> DSP32Mac_src1_bits) & DSP32Mac_src1_mask);
+    int dst  = ((iw1 >> DSP32Mac_dst_bits) & DSP32Mac_dst_mask);
+    int h10  = ((iw1 >> DSP32Mac_h10_bits) & DSP32Mac_h10_mask);
+    int h00  = ((iw1 >> DSP32Mac_h00_bits) & DSP32Mac_h00_mask);
+    int h11  = ((iw1 >> DSP32Mac_h11_bits) & DSP32Mac_h11_mask);
+    int h01  = ((iw1 >> DSP32Mac_h01_bits) & DSP32Mac_h01_mask);
+    uint32_t res = env->dreg[dst], res0 = 0, res1 = 0;
+    uint32_t sat0 = 0, sat1 = 0, v_i0 = 0, v_i1 = 0, v;
+
+    if (w1) {
+        uint64_t r = mac_multfunc(env, h01, h11, src0, src1, mmod, MM, &sat1);
+        res1 = mac_extract(r, mmod, MM, P, &v_i1);
+    }
+    if (w0) {
+        uint64_t r = mac_multfunc(env, h00, h10, src0, src1, mmod, 0, &sat0);
+        res0 = mac_extract(r, mmod, 0, P, &v_i0);
+    }
+    if (w1) {
+        if (P) {
+            env->dreg[dst + 1] = res1;
+        } else {
+            res = (res1 << 16) | (res & 0xffff);
+        }
+    }
+    if (w0) {
+        if (P) {
+            env->dreg[dst] = res0;
+        } else {
+            res = (res & 0xffff0000) | (res0 & 0xffff);
+        }
+    }
+    if (!P && (w0 || w1)) {
+        env->dreg[dst] = res;
+    }
+    if (w0 || w1) {
+        v = sat0 | sat1 | v_i0 | v_i1;
+        env->astat[ASTAT_V] = v;
+        env->astat[ASTAT_V_COPY] = v;
+        if (v) {
+            env->astat[ASTAT_VS] = 1;
+        }
+    }
+}

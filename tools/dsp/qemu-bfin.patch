+/*
+ * dsp32mac / dsp32mult, ported from the GNU sim (sim/bfin/bfin-sim.c,
+ * gdb 15.2): product sign extension from bit 31, accumulator saturation,
+ * rounding/truncation into half registers, V/VS/AV flags.  Both MAC halves
+ * read the source registers before anything is written back.
+ */
+static int is_macmod_signed(int x)
+{
+    return (x == 0) || (x == M_IS) || (x == M_T) || (x == M_S2RND)
+           || (x == M_ISS2) || (x == M_IH) || (x == M_W32);
+}
+
+static uint64_t mac_multfunc(CPUArchState *env, int h0, int h1, int src0,
+                             int src1, int mmod, int MM, uint32_t *psat)
+{
+    uint32_t s0 = env->dreg[src0], s1 = env->dreg[src1];
+    uint32_t sgn0, sgn1, val;
+    uint64_t val1;
+
+    if (h0) {
+        s0 >>= 16;
+    }
+    if (h1) {
+        s1 >>= 16;
+    }
+    s0 &= 0xffff;
+    s1 &= 0xffff;
+    sgn0 = -(s0 & 0x8000);
+    sgn1 = -(s1 & 0x8000);
+
+    if (MM) {
+        s0 |= sgn0;
+    } else {
+        switch (mmod) {
+        case 0: case M_S2RND: case M_T: case M_IS: case M_ISS2:
+        case M_IH: case M_W32:
+            s0 |= sgn0;
+            s1 |= sgn1;
+            break;
+        default:
+            break;
+        }
+    }
+
+    val = s0 * s1;
+    *psat = 0;
+    if (!MM && (mmod == 0 || mmod == M_T || mmod == M_S2RND || mmod == M_W32)) {
+        if (val == 0x40000000) {
+            val = (mmod == M_W32) ? 0x7fffffff : 0x80000000;
+            *psat = 1;
+        } else {
+            val <<= 1;
+        }
+    }
+    val1 = val;
+    if (is_macmod_signed(mmod) || MM) {
+        val1 |= -(val1 & 0x80000000);
+    }
+    if (*psat) {
+        val1 &= 0xFFFFFFFFull;
+    }
+    return val1;
+}

+/* Dreg = ASHIFT Dreg BY Dreg_lo (S), as lshift ()/ashiftrt () in the GNU sim */
+uint32_t HELPER(ashift32_sat)(uint32_t v, uint32_t src0)
+{
+    int32_t shft = (int8_t)(src0 << 2) >> 2;
+    uint64_t val = v;
+
+    if (shft < 0) {
+        int cnt = -shft > 32 ? 32 : -shft;
+        return cnt >= 32 ? (uint32_t)((int32_t)v >> 31)
+                         : (uint32_t)((int32_t)v >> cnt);
+    } else {
+        int cnt = shft, v_i;
+        uint64_t sgn = ~((val >> 31) - 1);
+        uint64_t mask = ~(uint64_t)0 << 31;
+        uint64_t new_val = val << cnt, masked;
+
+        sgn <<= 31;
+        masked = new_val & mask;
+        if (((val << cnt) >> 32) == 0
+            || (((val << cnt) >> 32) == ~((uint32_t)~0 << cnt)
+                && ((new_val >> 31) & 0x1))) {
+            v_i = 0;
+        } else {
+            v_i = 1;
+        }
+        new_val &= 0xFFFFFFFF;
+        masked &= 0xFFFFFFFF;
+        sgn &= 0xFFFFFFFF;
+        if (v_i || sgn != masked || (!sgn && new_val == 0 && val != 0)) {
+            new_val = sgn == 0 ? 0x7fffffff : 0x80000000;
+        }
+        return new_val;
+    }
+}
